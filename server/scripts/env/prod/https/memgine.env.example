# Placeholder production HTTPS configuration. Final DNS and secrets are supplied during production deployment.
MEMGINE_ENVIRONMENT=prod
MEMGINE_ENFORCE_HTTPS=true
MEMGINE_WEB_BASE_URL=https://memgine.mynikatech.in
MEMGINE_API_BASE_URL=https://api-memgine.mynikatech.in
MEMGINE_ALLOWED_ORIGINS=https://memgine.mynikatech.in
MEMGINE_DB_SCHEMA=memgineprod
MEMGINE_DB_POOL_SIZE=10
MEMGINE_OTP_PROVIDER=AWS_END_USER_MESSAGING_SMS
MEMGINE_ALLOW_LIVE_SMS=true
# Supplied by deployment properties from the production Canadian OTP origin.
# MEMGINE_OTP_AWS_ORIGINATION_IDENTITY_CA=
MEMGINE_CERTBOT_EMAIL=support@mynikatech.in
