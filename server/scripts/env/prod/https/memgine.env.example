# Placeholder production HTTPS configuration. Final DNS and secrets are supplied during production deployment.
MEMGINE_ENVIRONMENT=prod
MEMGINE_ENFORCE_HTTPS=true
MEMGINE_WEB_BASE_URL=https://memgine.mynikatech.in
MEMGINE_API_BASE_URL=https://api-memgine.mynikatech.in
MEMGINE_ALLOWED_ORIGINS=https://memgine.mynikatech.in
MEMGINE_DB_SCHEMA=memgineprod
MEMGINE_DB_POOL_SIZE=10
MEMGINE_ASSET_STORAGE_PROVIDER=S3
# MEMGINE_APP_DATA_BUCKET is injected by deployment.properties.
MEMGINE_AWS_REGION=ca-central-1
MEMGINE_OTP_PROVIDER=AWS_END_USER_MESSAGING_SMS
MEMGINE_ALLOW_LIVE_SMS=true
# Supplied by deployment properties from the production Canadian OTP origin.
# MEMGINE_OTP_AWS_ORIGINATION_IDENTITY_CA=
MEMGINE_CERTBOT_EMAIL=support@mynikatech.in

# Poynt Cloud app authentication: secret reference is stored per integration; privateKeyPem remains in AWS Secrets Manager.
MEMGINE_POYNT_CLOUD_BASE_URL=https://services.poynt.net
MEMGINE_POYNT_JWT_AUDIENCE=https://services.poynt.net
MEMGINE_POYNT_API_VERSION=1.2
MEMGINE_POYNT_SECRETS_REGION=ca-central-1
MEMGINE_POYNT_PAYMENT_BRIDGE_CALLBACK_URL=
MEMGINE_POYNT_PAYMENT_BRIDGE_CALLBACK_HEADER_NAME=X-Memgine-Poynt-Callback
MEMGINE_POYNT_PAYMENT_BRIDGE_CALLBACK_HEADER_VALUE=
MEMGINE_POYNT_PAYMENT_BRIDGE_TTL_SECONDS=45
