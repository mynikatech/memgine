# Direct local HTTP configuration; no Nginx required.
MEMGINE_ENVIRONMENT=local
MEMGINE_ENFORCE_HTTPS=false
MEMGINE_WEB_BASE_URL=http://localhost:8081
MEMGINE_API_BASE_URL=http://localhost:8082
MEMGINE_ALLOWED_ORIGINS=http://localhost:8081
MEMGINE_ASSET_STORAGE_PROVIDER=LOCAL
MEMGINE_OTP_PROVIDER=DEV
MEMGINE_ALLOW_LIVE_SMS=false

# Poynt Cloud app authentication: secret reference is stored per integration; privateKeyPem remains in AWS Secrets Manager.
MEMGINE_POYNT_CLOUD_BASE_URL=https://services.poynt.net
MEMGINE_POYNT_JWT_AUDIENCE=https://services.poynt.net
MEMGINE_POYNT_API_VERSION=1.2
MEMGINE_POYNT_SECRETS_REGION=ca-central-1
