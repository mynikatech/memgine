[Unit]
Description=Memgine backend (__SERVICE_NAME__)
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__WORKING_DIRECTORY__
EnvironmentFile=__ENV_FILE__
EnvironmentFile=-__SECRETS_ENV_FILE__
ExecStart=/usr/bin/java -jar __JAR_PATH__
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
