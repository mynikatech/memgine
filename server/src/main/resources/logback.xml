<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Memgine application logs -->
    <logger name="com.mynikatech.memgine" level="INFO"/>

    <!-- Framework/dependency noise -->
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="software.amazon.awssdk" level="WARN"/>
    <logger name="org.jdbi" level="WARN"/>
    <logger name="org.postgresql" level="WARN"/>

    <!-- Ktor operational messages -->
    <logger name="io.ktor" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>