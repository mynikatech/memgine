{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://memgine-dev.mynikatech.in"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "playstore-dev": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://memgine-dev.mynikatech.in"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight-dev": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://memgine-dev.mynikatech.in"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://memgine.mynikatech.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
