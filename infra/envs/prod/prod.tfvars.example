
# Memgine PROD Terraform variables
#
# Copy to prod.tfvars only if prod.tfvars does not exist.
# Review all values before first production provisioning.
#
# Do not store passwords, callback credentials or provider tokens here.

# AWS accounts and regions
aws_profile     = "memgine"
dns_aws_profile = "ApnaFundAdmin"
dns_aws_region  = "ap-south-1"

# EC2
instance_type = "t3.small"

# PostgreSQL RDS
db_instance_class           = "db.t4g.small"
db_engine_version           = "17.4"
db_allocated_storage_gb     = 20
db_max_allocated_storage_gb = 100

# Production data protection
db_backup_retention_days = 14
db_deletion_protection   = true
db_skip_final_snapshot   = false

# REQUIRED:
# Supply the actual production Meta WhatsApp phone-number ID
# before running Terraform with -input=false.
#
# meta_phone_number_id = "<approved-prod-meta-phone-number-id>"

# REQUIRED SECRET:
# whatsapp_delivery_ack_secret must be provided through
# TF_VAR_whatsapp_delivery_ack_secret.
#
# Never place its value in this file.

# Canadian SMS:
# Terraform provisions the Canadian OTP origination number
# through infra/envs/prod/sms.tf.
#
# The resulting number is exposed through the output:
# otp_sms_canada_origination_identity
#
# It is not configured through a Terraform input variable.
#
# Verify provider approval, registration, sending eligibility
# and operational readiness before enabling live SMS.

allow_live_sms = true
