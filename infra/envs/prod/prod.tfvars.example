# Copy to prod.tfvars. Do not put secret values in this file.
aws_profile     = "memgine"
dns_aws_profile = "ApnaFundAdmin"
dns_aws_region  = "ap-south-1"

instance_type               = "t3.small"
db_instance_class           = "db.t4g.small"
db_engine_version           = "17.4"
db_allocated_storage_gb     = 20
db_max_allocated_storage_gb = 100
db_backup_retention_days    = 14
db_deletion_protection      = true
db_skip_final_snapshot      = false

# Supply only existing secret ARNs; the RDS master secret is managed by RDS.
additional_secret_arns = [
  "arn:aws:secretsmanager:ca-central-1:REPLACE_ACCOUNT_ID:secret:memgine/prod/REPLACE_ME",
]
